{
  "name": "invoiceflow-landing",
  "version": "1.0.0",
  "description": "InvoiceFlow Landing Page - Performance optimized static website",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx serve .",
    "build": "node build/minify.js",
    "test": "echo \"No tests specified\"",
    "test:performance": "lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html --preset=desktop",
    "lighthouse": "npm run build && npx serve dist -l 3000 & sleep 2 && lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html --preset=desktop && pkill -f 'serve dist'",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "htmlhint *.html",
    "lint:css": "stylelint \"css/**/*.css\"",
    "lint:js": "eslint \"js/**/*.js\""
  },
  "keywords": [
    "invoicing",
    "landing-page",
    "static-site",
    "performance"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "cssnano": "^7.0.6",
    "eslint": "^9.17.0",
    "htmlhint": "^1.1.4",
    "lighthouse": "^12.2.1",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "terser": "^5.37.0"
  }
}